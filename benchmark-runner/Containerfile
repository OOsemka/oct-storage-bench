FROM docker.io/library/golang:1.22-alpine AS build

RUN apk add --no-cache git ca-certificates

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o benchmark-runner .

FROM scratch

COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /app/benchmark-runner /usr/local/bin/benchmark-runner

USER 1001

ENTRYPOINT ["benchmark-runner"]
